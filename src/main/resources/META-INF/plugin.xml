<idea-plugin require-restart="false">
    <id>io.github.yaml.pinterm</id>
    <name>PinTerm</name>
    <vendor url="https://github.com/yaml" email="coder-yaml@qq.com">yaml</vendor>
    <description><![CDATA[
        <p>Pin pinned terminals in the editor and run a one-line command.</p>
        <ul>
            <li>Toolbar icon opens configured tabs (Codex, Claude, Grok by default).</li>
            <li>Sessions open in the editor area and are pinned automatically.</li>
            <li>Optional single-line shell command after the session is running.</li>
            <li>Requires IntelliJ IDEA 2026.2+ and the bundled Reworked Terminal.</li>
        </ul>
        <p>PinTerm is not a sandbox. Commands run as the current user in the current project directory.</p>
    ]]></description>
    <!-- Change notes are generated from CHANGELOG.md at build time (see build.gradle.kts); the content below is only a fallback for tooling that reads this file directly. -->
    <change-notes><![CDATA[
        <p>0.1.0</p>
        <ul>
            <li>Initial open-source release as PinTerm.</li>
            <li>Toolbar icon-only dropdown for configured terminal tabs.</li>
            <li>Open and pin Reworked Terminal sessions in the editor.</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="io.github.yaml.pinterm.PinTermIdeDefaultsService"/>
        <applicationService serviceImplementation="io.github.yaml.pinterm.PinTermSettings"/>
        <applicationConfigurable
                groupId="tools"
                id="pinterm.settings"
                displayName="PinTerm"
                instance="io.github.yaml.pinterm.PinTermConfigurable"/>
        <notificationGroup id="PinTerm" displayType="BALLOON" isLogByDefault="true"/>
        <projectService serviceImplementation="io.github.yaml.pinterm.PinTermService"/>
    </extensions>

    <applicationListeners>
        <listener
                class="io.github.yaml.pinterm.PinTermDynamicPluginSupport"
                topic="com.intellij.ide.plugins.DynamicPluginListener"/>
        <listener
                class="io.github.yaml.pinterm.PinTermDynamicPluginSupport"
                topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

    <actions>
        <action
                id="PinTerm.ToolbarDropdown"
                class="io.github.yaml.pinterm.PinTermToolbarDropdownAction"
                text="PinTerm"
                description="Open a configured PinTerm tab"
                icon="/icons/pinterm.svg">
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
        </action>
    </actions>
</idea-plugin>

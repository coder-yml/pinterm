<idea-plugin require-restart="false">
    <id>io.github.yaml.pinterm</id>
    <name>PinTerm</name>
    <vendor url="https://github.com/coder-yml/pinterm" email="coder-yaml@qq.com">yaml</vendor>
    <description><![CDATA[
        <p>Pin pinned terminals in the editor and send a one-line command once the session is running.</p>
        <p>把终端固定在编辑器区域，并在会话进入运行态后发送一行命令。</p>
        <ul>
            <li>工具栏图标打开已配置的标签（默认提供 Codex、Claude、Grok）。</li>
            <li>终端会话在编辑器区域打开，并自动固定。</li>
            <li>会话进入运行态后，可选地发送一行 shell 命令。</li>
            <li>需要 IntelliJ IDEA 2026.2+ 及 IDE 自带的 Reworked Terminal。</li>
        </ul>
        <p>PinTerm 不是沙箱。命令会以当前用户身份、在当前项目目录下执行。</p>
    ]]></description>
    <!-- Change notes are generated from CHANGELOG.md at build time (see build.gradle.kts); the content below is only a fallback for tooling that reads this file directly. -->
    <change-notes><![CDATA[
        <p>0.1.0</p>
        <ul>
            <li>PinTerm 首次开源发布。</li>
            <li>仅图标的主工具栏下拉入口，用于打开已配置的终端标签。</li>
            <li>将 Reworked Terminal 会话打开到编辑器区域并固定。</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="io.github.yaml.pinterm.PinTermSettings"/>
        <applicationConfigurable
                groupId="tools"
                id="pinterm.settings"
                displayName="PinTerm"
                instance="io.github.yaml.pinterm.PinTermConfigurable"/>
        <notificationGroup id="PinTerm" displayType="BALLOON" isLogByDefault="true"/>
        <projectService serviceImplementation="io.github.yaml.pinterm.PinTermService"/>
        <postStartupActivity implementation="io.github.yaml.pinterm.PinTermStartupActivity"/>
    </extensions>

    <applicationListeners>
        <listener
                class="io.github.yaml.pinterm.PinTermDynamicPluginSupport"
                topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

    <actions>
        <action
                id="PinTerm.ToolbarDropdown"
                class="io.github.yaml.pinterm.PinTermToolbarDropdownAction"
                text="PinTerm"
                description="Open a configured PinTerm tab"
                icon="/icons/pinterm.svg">
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
